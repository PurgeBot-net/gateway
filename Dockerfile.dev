FROM golang:1.26-alpine AS builder
WORKDIR /build

COPY common/   ./common/
COPY database/ ./database/
COPY locale/   ./locale/
COPY gateway/  ./gateway/

WORKDIR /build/gateway
RUN go work init . ../common ../database ../locale
RUN go build -o /gateway ./cmd/

FROM alpine:latest
RUN adduser -D -g '' container
USER container
COPY --from=builder /gateway /gateway
ENTRYPOINT ["/gateway"]
